{
  "name": "one-piece-keynes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "import:punti": "node scripts/import-punti.mjs",
    "supabase:check": "node scripts/check-supabase.mjs",
    "supabase:migrate": "node scripts/migrate-supabase.mjs",
    "supabase:verify": "node scripts/verify-supabase.mjs",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.cloudflare.json",
    "test": "playwright test",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "node scripts/cloudflare-build.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "npm run build:vinext && wrangler deploy --config dist/server/wrangler.json --no-autoconfig",
    "cloudflare:types": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@vinext/cloudflare": "^1.0.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^8.3.3",
    "vite-css-modules": "^1.16.0",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
