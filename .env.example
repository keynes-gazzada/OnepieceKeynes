# Impostare credenziali proprie prima della pubblicazione.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Per inviare davvero i link di recupero password:
EMAIL_PROVIDER=resend
EMAIL_FROM=Keynes Grand Line <noreply@sitopuntikeynes.it>
RESEND_API_KEY=
# In alternativa, EMAIL_PROVIDER=smtp e configurare queste variabili:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_URL=http://localhost:3000
YOUTUBE_URL=
GITHUB_URL=
CONTACT_EMAIL=
# Percorso SQLite persistente su un server Node.js con disco scrivibile.
DATABASE_PATH=.data/one-piece.sqlite
# Supabase: URL e chiave pubblica da Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Connessione privata PostgreSQL da Connect > Session pooler. Non usare NEXT_PUBLIC_.
SUPABASE_DATABASE_URL=
# Se vuoto, Supabase viene selezionato quando è presente la connection string.
# Usa sqlite per lavorare sul database locale o postgres per richiedere Supabase.
DATABASE_DRIVER=
# Facoltativo: percorso di un certificato CA Supabase diverso da quello incluso.
SUPABASE_CA_CERT_PATH=
